APP_NAME=DSM Operational API
APP_ENV=development
DEBUG=true
DATABASE_URL=postgresql+asyncpg://dsm:dsm_password@localhost:5432/dsm_api
ADMIN_TOKEN=change-me
EMBEDDINGS_ENABLED=false
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
OPENAI_API_KEY=
RAG_ANSWER_ENABLED=false
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
FTS_LANGUAGE=portuguese
EMBEDDINGS_REQUIRED=false
DSM_RELEASE_ROOT=data/dsm/releases
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
